<Window x:Class="MarkingSystem.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="420"
        SizeToContent="Height"
        Background="White"
        FontFamily="pack://application:,,,/MarkingSystem;component/Fonts/#NanumSquare, 맑은 고딕, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FluentLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 긍정 버튼 (파랑) -->
            <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Background" Value="{StaticResource BluePrimary}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- 취소 버튼 (회색) -->
            <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Background" Value="#D8D8D8"/>
                <Setter Property="Foreground" Value="#555555"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 메시지 영역 -->
        <TextBlock x:Name="TxtMessage"
                   Grid.Row="0"
                   Margin="28,24,28,24"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="#333333"
                   LineHeight="22"/>

        <!-- 구분선 -->
        <Rectangle Grid.Row="1" Fill="{StaticResource DividerBrush}"/>

        <!-- 버튼 영역 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,12">
            <Button x:Name="BtnOk"
                    Content="확인"
                    Style="{StaticResource DialogPrimaryButton}"
                    Height="32" Padding="20,0"
                    Margin="0,0,8,0"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel"
                    Content="아니오"
                    Style="{StaticResource DialogSecondaryButton}"
                    Height="32" Padding="20,0"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
