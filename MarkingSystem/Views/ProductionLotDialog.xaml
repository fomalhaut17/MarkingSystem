<Window x:Class="MarkingSystem.Views.ProductionLotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="생산 Lot 조회"
        Width="1400" Height="750"
        MinWidth="1100" MinHeight="640"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="White"
        WindowStartupLocation="CenterOwner"
        FontFamily="NanumSquare, 나눔스퀘어, Segoe UI Variable, Segoe UI, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FluentDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── 사출 조건 표 셀 스타일 ── -->
            <!-- 그룹/행이름 셀 (파란-보라) -->
            <Style x:Key="InjGroupCell" TargetType="Border">
                <Setter Property="Background"       Value="#6272A4"/>
                <Setter Property="BorderBrush"      Value="#7F91C8"/>
                <Setter Property="BorderThickness"  Value="0,0,1,1"/>
            </Style>
            <!-- H1-H5 / 1차-5차 헤더 셀 (짙은 녹색) -->
            <Style x:Key="InjHeaderCell" TargetType="Border">
                <Setter Property="Background"       Value="#4E7A68"/>
                <Setter Property="BorderBrush"      Value="#6A9E88"/>
                <Setter Property="BorderThickness"  Value="0,0,1,1"/>
            </Style>
            <!-- 설정값 셀 (중간 녹색) -->
            <Style x:Key="InjSetCell" TargetType="Border">
                <Setter Property="Background"       Value="#5CAA6A"/>
                <Setter Property="BorderBrush"      Value="#FFFFFF"/>
                <Setter Property="BorderThickness"  Value="0,0,1,1"/>
            </Style>
            <!-- 실제값 셀 (흰색) -->
            <Style x:Key="InjActCell" TargetType="Border">
                <Setter Property="Background"       Value="#FFFFFF"/>
                <Setter Property="BorderBrush"      Value="#CCCCCC"/>
                <Setter Property="BorderThickness"  Value="0,0,1,1"/>
            </Style>

            <!-- 그룹/헤더 텍스트 -->
            <Style x:Key="InjGroupText" TargetType="TextBlock">
                <Setter Property="Foreground"           Value="White"/>
                <Setter Property="FontWeight"           Value="Bold"/>
                <Setter Property="FontSize"             Value="11"/>
                <Setter Property="HorizontalAlignment"  Value="Center"/>
                <Setter Property="VerticalAlignment"    Value="Center"/>
                <Setter Property="TextAlignment"        Value="Center"/>
                <Setter Property="TextWrapping"         Value="Wrap"/>
                <Setter Property="Padding"              Value="2"/>
            </Style>
            <!-- 행이름 텍스트 -->
            <Style x:Key="InjRowText" TargetType="TextBlock">
                <Setter Property="Foreground"           Value="White"/>
                <Setter Property="FontSize"             Value="11"/>
                <Setter Property="HorizontalAlignment"  Value="Center"/>
                <Setter Property="VerticalAlignment"    Value="Center"/>
                <Setter Property="TextAlignment"        Value="Center"/>
                <Setter Property="TextWrapping"         Value="Wrap"/>
                <Setter Property="Padding"              Value="2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>  <!-- 툴바 -->
            <RowDefinition Height="1"/>   <!-- 구분선 -->
            <RowDefinition Height="*"/>   <!-- 본문 -->
        </Grid.RowDefinitions>

        <!-- ══ 툴바 ══ -->
        <Grid Grid.Row="0" Margin="20,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Lot 바코드"
                       FontSize="13" Foreground="#333333"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>

            <TextBox Grid.Column="1" x:Name="TxtSearchBarcode"
                     Style="{StaticResource FluentTextBox}"
                     VerticalAlignment="Center" Height="36"/>

            <Button Grid.Column="2" Content="Lot 조회"
                    Style="{StaticResource ToolbarYellowButton}"
                    Width="110" Height="38"
                    Margin="12,0,0,0"
                    Click="LotSearchBtn_Click"/>

            <TextBlock Grid.Column="4" x:Name="TxtDate"
                       FontSize="14" Foreground="#333333"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 구분선 -->
        <Rectangle Grid.Row="1" Fill="#E0E0E0"/>

        <!-- ══ 본문 ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>  <!-- 좌측 패널 -->
                <ColumnDefinition Width="*"/>    <!-- 우측 패널 -->
            </Grid.ColumnDefinitions>

            <!-- ── 좌측 패널 ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,20,20,20">

                    <!-- Lot 바코드 -->
                    <TextBlock Text="Lot 바코드" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLotBarcode"
                             Style="{StaticResource FluentTextBox}"
                             IsReadOnly="True" Height="34" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbLotHistory" Height="30" Margin="0,0,0,20"/>

                    <!-- 품명 -->
                    <TextBlock Text="품명" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtProductName"
                             Style="{StaticResource FluentTextBox}"
                             IsReadOnly="True" Height="34" Margin="0,0,0,20"/>

                    <!-- 제조일자 -->
                    <TextBlock Text="제조일자" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtManufactureDate"
                             Style="{StaticResource FluentTextBox}"
                             IsReadOnly="True" Height="34" Margin="0,0,0,20"/>

                    <!-- 생산설비 -->
                    <TextBlock Text="생산설비" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtProductionEquipment"
                             Style="{StaticResource FluentTextBox}"
                             IsReadOnly="True" Height="34" Margin="0,0,0,20"/>

                    <!-- 생산금형 -->
                    <TextBlock Text="생산금형" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtProductionMold"
                             Style="{StaticResource FluentTextBox}"
                             IsReadOnly="True" Height="34" Margin="0,0,0,20"/>

                    <!-- Lot 생산 수량 -->
                    <TextBlock Text="Lot 생산 수량" FontSize="13" Foreground="#555555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLotProductionQty"
                             Style="{StaticResource FluentTextBox}"
                             IsReadOnly="True" Height="34"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── 우측 패널 ── -->
            <Grid Grid.Column="1" Margin="0,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 사출 조건 표 -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Border BorderBrush="#AAAAAA" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>   <!-- Col 0: 그룹명 -->
                                <ColumnDefinition Width="110"/>  <!-- Col 1: 행이름 -->
                                <ColumnDefinition Width="65"/>   <!-- Col 2: H1 Set -->
                                <ColumnDefinition Width="65"/>   <!-- Col 3: H1 Act -->
                                <ColumnDefinition Width="65"/>   <!-- Col 4: H2 Set -->
                                <ColumnDefinition Width="65"/>   <!-- Col 5: H2 Act -->
                                <ColumnDefinition Width="65"/>   <!-- Col 6: H3 Set -->
                                <ColumnDefinition Width="65"/>   <!-- Col 7: H3 Act -->
                                <ColumnDefinition Width="65"/>   <!-- Col 8: H4 Set -->
                                <ColumnDefinition Width="65"/>   <!-- Col 9: H4 Act -->
                                <ColumnDefinition Width="65"/>   <!-- Col 10: H5 Set -->
                                <ColumnDefinition Width="65"/>   <!-- Col 11: H5 Act -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>  <!-- Row  0: H1-H5 헤더 -->
                                <RowDefinition Height="32"/>  <!-- Row  1: 온도(°C) -->
                                <RowDefinition Height="32"/>  <!-- Row  2: 1차-5차 서브헤더 -->
                                <RowDefinition Height="32"/>  <!-- Row  3: 압력 [성형1차] -->
                                <RowDefinition Height="32"/>  <!-- Row  4: 속도 [성형1차] -->
                                <RowDefinition Height="32"/>  <!-- Row  5: 15  [성형1차] -->
                                <RowDefinition Height="32"/>  <!-- Row  6: 압력 [계량조건] -->
                                <RowDefinition Height="32"/>  <!-- Row  7: 속도 [계량조건] -->
                                <RowDefinition Height="32"/>  <!-- Row  8: 위치 [계량조건] -->
                                <RowDefinition Height="32"/>  <!-- Row  9: 압력 [보압] -->
                                <RowDefinition Height="32"/>  <!-- Row 10: 속도 [보압] -->
                                <RowDefinition Height="32"/>  <!-- Row 11: 시간 [보압] -->
                                <RowDefinition Height="32"/>  <!-- Row 12: 1-4  [HOT RUNNER] -->
                                <RowDefinition Height="32"/>  <!-- Row 13: 5-8  [HOT RUNNER] -->
                                <RowDefinition Height="32"/>  <!-- Row 14: 냉각시간 -->
                                <RowDefinition Height="32"/>  <!-- Row 15: 금형보호 -->
                                <RowDefinition Height="32"/>  <!-- Row 16: 가스위치 -->
                            </Grid.RowDefinitions>

                            <!-- ══ ROW 0: 최상단 헤더 (H1~H5) ══ -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource InjGroupCell}"/>
                            <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="H1" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="H2" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="H3" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="H4" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="10" Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="H5" Style="{StaticResource InjGroupText}"/>
                            </Border>

                            <!-- ══ ROWS 1-5: 성형조건1차 ══ -->
                            <!-- 그룹명 셀 (RowSpan=5) -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="5" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="성형조건1차" Style="{StaticResource InjGroupText}"/>
                            </Border>

                            <!-- Row 1: 온도(°C) -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="온도(°C)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="1" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="1" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="1" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="1" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="1" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="1" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="1" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="1" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="1" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 2: 1차~5차 서브헤더 -->
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InjGroupCell}"/>
                            <Border Grid.Row="2" Grid.Column="2"  Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="1차" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="4"  Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="2차" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="6"  Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="3차" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="8"  Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="4차" Style="{StaticResource InjGroupText}"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="10" Grid.ColumnSpan="2" Style="{StaticResource InjHeaderCell}">
                                <TextBlock Text="5차" Style="{StaticResource InjGroupText}"/>
                            </Border>

                            <!-- Row 3: 압력(Kg/cm2) [성형1차] -->
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="압력(Kg/cm2)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="3" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="3" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="3" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="3" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="3" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="3" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="3" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="3" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="3" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 4: 속도(%) [성형1차] -->
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="속도(%)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="4" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="4" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="4" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="4" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="4" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="4" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="4" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="4" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="4" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 5: 15 [성형1차] -->
                            <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="15" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="5" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="5" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="5" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="5" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="5" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="5" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="5" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="5" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="5" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- ══ ROWS 6-8: 계량조건 ══ -->
                            <Border Grid.Row="6" Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="계량조건" Style="{StaticResource InjGroupText}"/>
                            </Border>

                            <!-- Row 6: 압력 -->
                            <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="압력(Kg/cm2)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="6" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="6" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="6" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="6" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="6" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="6" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="6" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="6" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="6" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 7: 속도 -->
                            <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="속도(%)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="7" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="7" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="7" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="7" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="7" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="7" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="7" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="7" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="7" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="7" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 8: 위치 -->
                            <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="위치(mm)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="8" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="8" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="8" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="8" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="8" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="8" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="8" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="8" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="8" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="8" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- ══ ROWS 9-11: 보압 ══ -->
                            <Border Grid.Row="9" Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="보압" Style="{StaticResource InjGroupText}"/>
                            </Border>

                            <!-- Row 9: 압력 -->
                            <Border Grid.Row="9" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="압력(Kg/cm2)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="9" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="9" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="9" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="9" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="9" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="9" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="9" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="9" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="9" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="9" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 10: 속도 -->
                            <Border Grid.Row="10" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="속도(%)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="10" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="10" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="10" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="10" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="10" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="10" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="10" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="10" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="10" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="10" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- Row 11: 시간 -->
                            <Border Grid.Row="11" Grid.Column="1" Style="{StaticResource InjGroupCell}">
                                <TextBlock Text="시간(초)" Style="{StaticResource InjRowText}"/>
                            </Border>
                            <Border Grid.Row="11" Grid.Column="2"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="11" Grid.Column="3"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="11" Grid.Column="4"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="11" Grid.Column="5"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="11" Grid.Column="6"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="11" Grid.Column="7"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="11" Grid.Column="8"  Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="11" Grid.Column="9"  Style="{StaticResource InjActCell}"/>
                            <Border Grid.Row="11" Grid.Column="10" Style="{StaticResource InjSetCell}"/>
                            <Border Grid.Row="11" Grid.Column="11" Style="{StaticResource InjActCell}"/>

                            <!-- ══ ROWS 12-13: HOT RUNNER ══ -->
                            <Border Grid.Row="12" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource InjGroupCell}">
