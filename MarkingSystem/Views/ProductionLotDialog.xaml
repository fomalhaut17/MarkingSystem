<Window x:Class="MarkingSystem.Views.ProductionLotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="생산 Lot 조회"
        Width="960" Height="680"
        MinWidth="800" MinHeight="560"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="White"
        WindowStartupLocation="CenterOwner"
        FontFamily="NanumSquare, 나눔스퀘어, Segoe UI Variable, Segoe UI, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary Source="../Styles/FluentDark.xaml"/>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 헤더 정보  -->
            <RowDefinition Height="1"/>     <!-- 구분선     -->
            <RowDefinition Height="*"/>     <!-- Lot 목록  -->
            <RowDefinition Height="Auto"/>  <!-- 사출 조건 제목 -->
            <RowDefinition Height="180"/>   <!-- 사출 조건 표  -->
            <RowDefinition Height="Auto"/>  <!-- 푸터 버튼  -->
        </Grid.RowDefinitions>

        <!-- ── 헤더: 주요 정보 ── -->
        <Grid Grid.Row="0" Margin="20,16" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="물류 바코드" Style="{StaticResource LabelText}"/>
                <TextBlock x:Name="TxtMaterialBarcode" Text="-" Style="{StaticResource BodyText}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="품명" Style="{StaticResource LabelText}"/>
                <TextBlock x:Name="TxtProductName" Text="-" Style="{StaticResource BodyText}" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                <TextBlock Text="Lot 코드" Style="{StaticResource LabelText}"/>
                <TextBlock x:Name="TxtLotCode" Text="-" Style="{StaticResource BodyText}" FontWeight="Bold"
                           FontFamily="Consolas, Courier New, Malgun Gothic" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="작업일시" Style="{StaticResource LabelText}"/>
                <TextBlock x:Name="TxtWorkDate" Text="-" Style="{StaticResource BodyText}" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- 구분선 -->
        <Rectangle Grid.Row="1" Fill="#E0E0E0"/>

        <!-- ── Lot 목록 ── -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 요약 칩 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,10,20,8">
                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                        CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtOkCount" Text="양품 (OK)  0"
                               Foreground="#2E7D32" FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1"
                        CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtNgCount" Text="불량 (NG)  0"
                               Foreground="#C62828" FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1"
                        CornerRadius="12" Padding="12,4" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtAdCount" Text="대기 (AD)  0"
                               Foreground="#E65100" FontSize="12" FontWeight="Bold"/>
                </Border>
                <Border Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="12" Padding="12,4">
                    <TextBlock x:Name="TxtTotalCount" Text="합계  0"
                               Foreground="#555555" FontSize="12" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1"
                      x:Name="LotGrid"
                      Margin="20,0,20,0"
                      Style="{StaticResource FluentDataGrid}"
                      ColumnHeaderStyle="{StaticResource FluentColumnHeader}"
                      RowStyle="{StaticResource FluentDataGridRow}"
                      CellStyle="{StaticResource FluentDataGridCell}"
                      BorderThickness="1"
                      BorderBrush="#E0E0E0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="순번"       Binding="{Binding Sequence}"        Width="60"/>
                    <DataGridTextColumn Header="물류 바코드" Binding="{Binding MaterialBarcode}" Width="160"/>
                    <DataGridTextColumn Header="Lot 바코드" Binding="{Binding LotBarcode}"      Width="*"/>
                    <DataGridTextColumn Header="Lot Ser"   Binding="{Binding LotSer}"           Width="80"/>
                    <DataGridTemplateColumn Header="검사결과" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txt" Text="{Binding ResultText}"
                                           FontWeight="Bold" Foreground="#888888"
                                           VerticalAlignment="Center"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ResultText}" Value="OK">
                                        <Setter TargetName="txt" Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultText}" Value="NG">
                                        <Setter TargetName="txt" Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultText}" Value="AD">
                                        <Setter TargetName="txt" Property="Foreground" Value="#E65100"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ── 사출 조건 제목 ── -->
        <Border Grid.Row="3" Background="#F5F5F5" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,1" Padding="20,8">
            <TextBlock Text="사출 조건" FontSize="13" FontWeight="Bold" Foreground="#555555"/>
        </Border>

        <!-- ── 사출 조건 표 ── -->
        <DataGrid Grid.Row="4"
                  x:Name="InjGrid"
                  Margin="20,0,20,0"
                  Style="{StaticResource FluentDataGrid}"
                  ColumnHeaderStyle="{StaticResource FluentColumnHeader}"
                  RowStyle="{StaticResource FluentDataGridRow}"
                  CellStyle="{StaticResource FluentDataGridCell}"
                  RowHeight="32" ColumnHeaderHeight="34"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="항목"  Binding="{Binding ParameterName}" Width="160"/>
                <DataGridTextColumn Header="단위"  Binding="{Binding Unit}"           Width="60"/>
                <DataGridTextColumn Header="노즐"  Binding="{Binding Nozzle}"         Width="*"/>
                <DataGridTextColumn Header="H1"   Binding="{Binding H1}"             Width="*"/>
                <DataGridTextColumn Header="H2"   Binding="{Binding H2}"             Width="*"/>
                <DataGridTextColumn Header="H3"   Binding="{Binding H3}"             Width="*"/>
                <DataGridTextColumn Header="H4"   Binding="{Binding H4}"             Width="*"/>
                <DataGridTextColumn Header="H5"   Binding="{Binding H5}"             Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── 푸터 ── -->
        <Border Grid.Row="5" Background="#F8F8F8" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Button Content="닫기" Click="CloseBtn_Click"
                    Style="{StaticResource FluentButton}"
                    HorizontalAlignment="Right"
                    Width="100" Height="36"/>
        </Border>
    </Grid>
</Window>
