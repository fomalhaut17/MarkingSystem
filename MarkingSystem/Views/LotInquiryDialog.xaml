<Window x:Class="MarkingSystem.Views.LotInquiryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lot 조회"
        Width="900" Height="600"
        MinWidth="700" MinHeight="460"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="White"
        WindowStartupLocation="CenterOwner"
        FontFamily="pack://application:,,,/MarkingSystem;component/Fonts/#NanumSquare, 맑은 고딕, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FluentLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>   <!-- 0: 툴바           -->
            <RowDefinition Height="1"/>    <!-- 1: 구분선          -->
            <RowDefinition Height="*"/>    <!-- 2: DataGrid       -->
            <RowDefinition Height="1"/>    <!-- 3: 구분선          -->
            <RowDefinition Height="90"/>   <!-- 4: 하단 버튼       -->
        </Grid.RowDefinitions>

        <!-- ── 툴바 ── -->
        <Grid Grid.Row="0" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- 입력 영역 -->
                <ColumnDefinition Width="*"/>     <!-- 여백      -->
                <ColumnDefinition Width="Auto"/>  <!-- 날짜      -->
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="물류 바코드 / Lot 코드"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="TxtSearchInput"
                         Style="{StaticResource FluentTextBox}"
                         Width="260" Height="40"
                         KeyDown="TxtSearchInput_KeyDown"/>
                <Button Content="조회"
                        Style="{StaticResource ToolbarYellowButton}"
                        Height="40" Padding="20,0"
                        Margin="8,0,0,0"
                        Click="SearchBtn_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtDate"
                       Grid.Column="2"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#333333"
                       VerticalAlignment="Center"/>
        </Grid>

        <Rectangle Grid.Row="1" Fill="{StaticResource DividerBrush}"/>

        <!-- ── DataGrid ── -->
        <DataGrid Grid.Row="2"
                  x:Name="ResultDataGrid"
                  Style="{StaticResource FluentDataGrid}"
                  ColumnHeaderStyle="{StaticResource FluentColumnHeader}"
                  RowStyle="{StaticResource FluentDataGridRow}"
                  CellStyle="{StaticResource FluentDataGridCell}"
                  BorderThickness="0"
                  Margin="16,12,16,0">
            <DataGrid.Columns>

                <!-- 체크박스 -->
                <DataGridTemplateColumn Width="50">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource FluentCheckBox}"
                                      HorizontalAlignment="Center"
                                      Click="HeaderCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource FluentCheckBox}"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 물류 바코드 -->
                <DataGridTextColumn Header="물류 바코드"
                                   Binding="{Binding MaterialBarcode}"
                                   Width="200" MinWidth="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize"          Value="14"/>
                            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Lot 바코드 -->
                <DataGridTextColumn Header="Lot 바코드"
                                   Binding="{Binding LotBarcode}"
                                   Width="300" MinWidth="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize"          Value="14"/>
                            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 검사결과 -->
                <DataGridTemplateColumn Header="검사결과" Width="100" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="resultTxt"
                                       Text="{Binding ResultText}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ResultText}" Value="OK">
                                    <Setter TargetName="resultTxt" Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultText}" Value="NG">
                                    <Setter TargetName="resultTxt" Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultText}" Value="AD">
                                    <Setter TargetName="resultTxt" Property="Foreground" Value="#E65100"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Rectangle Grid.Row="3" Fill="{StaticResource DividerBrush}"/>

        <!-- ── 하단 버튼 ── -->
        <Grid Grid.Row="4" Margin="24,0">
            <Button x:Name="BtnMarkDefect"
                    Content="불량 처리"
                    Style="{StaticResource LargeYellowButton}"
                    Width="120" Height="60"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="MarkDefectBtn_Click"/>
            <Button Content="종료"
                    Style="{StaticResource LargeYellowButton}"
                    Width="120" Height="60"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="CloseBtn_Click"/>
        </Grid>
    </Grid>
</Window>
