<Window x:Class="MarkingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="만텍 각인 시스템 — 로그인"
        Width="400" Height="440"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="pack://application:,,,/MarkingSystem;component/Fonts/#NanumSquare, 맑은 고딕, Malgun Gothic">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>   <!-- 타이틀     -->
            <RowDefinition Height="*"/>    <!-- 입력 폼    -->
            <RowDefinition Height="30"/>   <!-- 오류 메시지 -->
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <TextBlock Grid.Row="0"
                   Text="각인 장치 제어 관리 시스템"
                   Style="{StaticResource TitleText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- 입력 폼 -->
        <StackPanel Grid.Row="1" Margin="40,0,40,10" VerticalAlignment="Center">
            <!-- 업체코드: 임시 숨김 (DEMO 고정, 차후 재사용 예정) -->
            <TextBlock Text="업체코드" Style="{StaticResource LabelText}" Margin="0,0,0,4" Visibility="Collapsed"/>
            <TextBox x:Name="TxtCompanyCode"
                     Style="{StaticResource FluentTextBox}"
                     Height="40"
                     Margin="0,0,0,12"
                     Visibility="Collapsed"
                     KeyDown="Input_KeyDown"/>

            <TextBlock Text="아이디" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername"
                     Style="{StaticResource FluentTextBox}"
                     Height="40"
                     Margin="0,0,0,12"
                     KeyDown="Input_KeyDown"/>

            <TextBlock Text="비밀번호" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PwdPassword"
                         Height="40"
                         Margin="0,0,0,12"
                         Padding="10,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource InputBackground}"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         KeyDown="Input_KeyDown"/>

            <CheckBox x:Name="ChkRememberMe"
                      Content="로그인 정보 기억하기"
                      Style="{StaticResource FluentCheckBox}"
                      FontSize="13"
                      Margin="0,0,0,16"/>

            <Button Content="로그인"
                    Style="{StaticResource LargeBlueButton}"
                    Height="50"
                    Click="LoginBtn_Click"/>
        </StackPanel>

        <!-- 오류 메시지 -->
        <TextBlock x:Name="TxtError"
                   Grid.Row="2"
                   FontSize="13"
                   Foreground="#C62828"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
