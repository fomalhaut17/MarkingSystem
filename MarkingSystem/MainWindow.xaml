<Window x:Class="MarkingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarkingSystem.ViewModels"
        Title="만텍 각인 시스템"
        Height="860" Width="1400"
        MinHeight="700" MinWidth="1000"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="White"
        FontFamily="NanumSquare, 나눔스퀘어, Segoe UI Variable, Segoe UI, Malgun Gothic">

    <Window.Resources>
        <ResourceDictionary Source="Styles/FluentDark.xaml"/>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: 제목 + 툴바     -->
            <RowDefinition Height="1"/>     <!-- 1: 구분선           -->
            <RowDefinition Height="*"/>     <!-- 2: 메인 컨텐츠     -->
            <RowDefinition Height="1"/>     <!-- 3: 구분선           -->
            <RowDefinition Height="110"/>   <!-- 4: 하단 액션 버튼   -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             ROW 0 – 제목 + 툴바
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Height="70" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- 앱 제목 -->
                <ColumnDefinition Width="*"/>     <!-- 여백    -->
                <ColumnDefinition Width="Auto"/>  <!-- 툴바    -->
                <ColumnDefinition Width="*"/>     <!-- 여백    -->
                <ColumnDefinition Width="Auto"/>  <!-- 날짜    -->
            </Grid.ColumnDefinitions>

            <!-- 앱 제목 -->
            <TextBlock Grid.Column="0"
                       Text="각인 장치 제어 관리 시스템"
                       Style="{StaticResource TitleText}"
                       VerticalAlignment="Center"/>

            <!-- 툴바: Lot 바코드 입력 + 버튼 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lot 바코드"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBox x:Name="TxtBarcode"
                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FluentTextBox}"
                         Width="240" Height="40"
                         KeyDown="TxtBarcode_KeyDown"/>
                <Button Content="Lot 조회"
                        Command="{Binding LookupCommand}"
                        Style="{StaticResource ToolbarYellowButton}"
                        Height="40" Padding="20,0"
                        Margin="8,0,0,0"/>
                <Button Content="{Binding ModeButtonText}"
                        Command="{Binding ToggleModeCommand}"
                        Style="{StaticResource ToolbarBlueButton}"
                        Height="40" Padding="20,0"
                        Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 날짜 -->
            <TextBlock Grid.Column="4"
                       Text="{Binding CurrentDateText}"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#333333"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ── 가로 구분선 ── -->
        <Rectangle Grid.Row="1" Fill="{StaticResource DividerBrush}"/>

        <!-- ══════════════════════════════════════════════════════
             ROW 2 – 메인 컨텐츠 (좌: 정보 폼 | 우: Lot 그리드)
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>  <!-- 좌: 정보 패널  -->
                <ColumnDefinition Width="1"/>    <!-- 세로 구분선    -->
                <ColumnDefinition Width="*"/>    <!-- 우: DataGrid  -->
            </Grid.ColumnDefinitions>

            <!-- ── 좌측 정보 패널 ── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="White">
                <StackPanel Margin="24,20,24,16">

                    <!-- 물류 바코드 -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="물류 바코드" Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                            <TextBlock Text="{Binding CurrentMaterial.MaterialBarcode, FallbackValue=''}"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <!-- 품명 -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="품명" Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                            <TextBlock Text="{Binding CurrentMaterial.ProductName, FallbackValue=''}"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <!-- 제조일자 -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="제조일자" Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                            <TextBlock Text="{Binding CurrentMaterial.ManufactureDate, FallbackValue=''}"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- 용기 내 수량 -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="용기 내 수량" Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                            <TextBlock Text="{Binding CurrentMaterial.ContainerQty, FallbackValue=''}"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Lot 코드 -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Lot 코드" Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                            <TextBlock Text="{Binding CurrentMaterial.LotCode, FallbackValue=''}"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New, Malgun Gothic"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <!-- 최종 발행 Ser. -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="최종 발행 Ser." Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                            <TextBlock Text="{Binding CurrentMaterial.LastIssuedSer, FallbackValue=''}"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New, Malgun Gothic"/>
                        </Border>
                    </StackPanel>

                    <!-- 양품 / 불량 (나란히) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="양품" Style="{StaticResource LabelText}"/>
                            <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                                <TextBlock Text="{Binding OkCount}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           Margin="10,0" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="불량" Style="{StaticResource LabelText}"/>
                            <Border Background="{StaticResource FieldBackground}" Height="38" CornerRadius="2">
                                <TextBlock Text="{Binding NgCount}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#C62828"
                                           Margin="10,0" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- ── 세로 구분선 ── -->
            <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}"/>

            <!-- ── 우측 Lot DataGrid ── -->
            <DataGrid Grid.Column="2"
                      x:Name="LotDataGrid"
                      ItemsSource="{Binding LotEntries}"
                      Style="{StaticResource FluentDataGrid}"
                      ColumnHeaderStyle="{StaticResource FluentColumnHeader}"
                      RowStyle="{StaticResource FluentDataGridRow}"
                      CellStyle="{StaticResource FluentDataGridCell}"
                      SelectionChanged="LotDataGrid_SelectionChanged"
                      BorderThickness="0">
                <DataGrid.Columns>

                    <!-- 체크박스 -->
                    <DataGridTemplateColumn Width="50" MinWidth="44" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource FluentCheckBox}"
                                          HorizontalAlignment="Center"
                                          Click="HeaderCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource FluentCheckBox}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Click="RowCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 물류 바코드 -->
                    <DataGridTextColumn Header="물류 바코드"
                                       Binding="{Binding MaterialBarcode}"
                                       Width="200" MinWidth="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize"          Value="14"/>
                                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Lot 바코드 -->
                    <DataGridTextColumn Header="Lot 바코드"
                                       Binding="{Binding LotBarcode}"
                                       Width="*" MinWidth="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontFamily"        Value="Consolas, Courier New, Malgun Gothic"/>
                                <Setter Property="FontSize"          Value="13"/>
                                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 검사결과 -->
                    <DataGridTemplateColumn Header="검사결과" Width="100" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="resultTxt"
                                           Text="{Binding ResultText}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#888888"
                                           VerticalAlignment="Center"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ResultText}" Value="OK">
                                        <Setter TargetName="resultTxt" Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultText}" Value="NG">
                                        <Setter TargetName="resultTxt" Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultText}" Value="AD">
                                        <Setter TargetName="resultTxt" Property="Foreground" Value="#E65100"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- ── 가로 구분선 ── -->
        <Rectangle Grid.Row="3" Fill="{StaticResource DividerBrush}"/>

        <!-- ══════════════════════════════════════════════════════
             ROW 4 – 하단 액션 버튼 (5개 균등 분할)
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 발행 시작 -->
            <Button Grid.Column="0"
                    Content="발행 시작"
                    Command="{Binding StartPublishCommand}"
                    Style="{StaticResource LargeBlueButton}"/>

            <!-- 발행 종료 -->
            <Button Grid.Column="1"
                    Content="발행 종료"
                    Command="{Binding StopPublishCommand}"
                    Style="{StaticResource LargeYellowButton}"/>

            <!-- 불량 처리 -->
            <Button Grid.Column="2"
                    Content="불량 처리"
                    Command="{Binding MarkDefectCommand}"
                    Style="{StaticResource LargeYellowButton}"/>

            <!-- 생산 Lot 조회 -->
            <Button Grid.Column="3"
                    Content="생산 Lot 조회"
                    Command="{Binding ProductionLotInquiryCommand}"
                    Style="{StaticResource LargeYellowButton}"/>

            <!-- 결과 저장 -->
            <Button Grid.Column="4"
                    Content="결과 저장"
                    Command="{Binding SaveResultCommand}"
                    Style="{StaticResource LargeActionButton}"
                    Background="#D8D8D8"
                    Foreground="#888888"/>

        </Grid>
    </Grid>
</Window>
